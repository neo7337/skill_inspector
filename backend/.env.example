# Backend environment variables (optional)
# These can be set here OR entered directly in the UI

# OpenAI API key (if using OpenAI as default provider)
# OPENAI_API_KEY=sk-...

# Anthropic API key (if using Anthropic as default provider)
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama base URL
#   - Running locally (make dev):  http://localhost:11434  (default, no need to set)
#   - Running in Docker Compose:   set automatically via docker-compose.yml → host.docker.internal:11434
# OLLAMA_BASE_URL=http://localhost:11434
